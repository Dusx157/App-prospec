# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Required for server-side Places API (New) and Geocoding API calls.
# VITE_GOOGLE_MAPS_API_KEY: Optional client-side Maps JavaScript API key.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_VITE_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Server-side WhatsApp webhook gateway (Evolution API, Z-API, Cloud API, Make/n8n)
# Enables background batch dispatch in "Disparos automáticos" without manual clicks.
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
